NODE_ENV=development
AI_SERVER_PORT=8787

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Admin approval code — must be a long random string (>= 32 chars).
# In production, only set this via your secret manager / hosting env vars.
ADMIN_APPROVAL_CODE=replace-with-long-random-admin-code

# Server-side pepper applied via HMAC-SHA256 before scrypt.
# Required in production. Rotating this invalidates all stored passwords.
PASSWORD_PEPPER=replace-with-long-random-pepper

# Comma-separated list of allowed origins for CORS, e.g.
# ALLOWED_ORIGINS=https://harujeongri.com,https://app.harujeongri.com
ALLOWED_ORIGINS=

# Set to true only when behind a trusted reverse proxy (Vercel/Cloudflare/nginx)
# that sets X-Forwarded-For. Otherwise IP-based rate limiting can be spoofed.
TRUST_PROXY=false

# SMTP — production must use implicit TLS (465) or STARTTLS enforced.
# Gmail example (STARTTLS):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM=하루정리 <your-email@gmail.com>
# Naver example (implicit TLS):
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=15000

# Never enable in production — leaks verification codes to logs.
EMAIL_DEBUG_CODES=false
